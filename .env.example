# --- Server ---
NODE_ENV=development
PORT=3000
# Comma-separated list, or * to allow any origin
CORS_ORIGINS=*
# Base URL the API is reachable at — used to build public URLs for uploaded files
PUBLIC_BASE_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/friendship_app

# --- Firebase Authentication ---
# Sign-in (phone OTP, Google, Apple) happens in the app with the Firebase SDK.
# The app sends the Firebase ID token as `Authorization: Bearer <idToken>`.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional service account (Project settings → Service accounts → Generate new private key).
# Only needed to delete Firebase users on account deletion and to revoke sessions.
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; \n sequences are turned into newlines.
FIREBASE_PRIVATE_KEY=
# Reject revoked sessions too (one network call per request). Requires the service account.
FIREBASE_CHECK_REVOKED=false
# Development only: accept tokens from a running Firebase Auth Emulator, e.g. 127.0.0.1:9099. Leave empty for a real project.
FIREBASE_AUTH_EMULATOR_HOST=

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# --- Product rules ---
FREE_CHAT_CAPACITY=3
SIGNUP_BONUS_COINS=139
QUICK_MATCH_COST=50
QUICK_MATCH_DURATION_SECONDS=300
AVATAR_PREMIUM_COST=50

# --- Payments ---
# Allows the "test" payment provider, which grants purchases without a store receipt. Never enable in production.
ALLOW_TEST_PAYMENTS=true
# Development only: selfie verifications are approved immediately instead of waiting for review.
VERIFICATION_AUTO_APPROVE=true

# --- Admin portal ---
# Signs admin session tokens. Required in production; generate with: openssl rand -base64 48
# In development a random secret is used when empty, so admins are signed out on every restart.
ADMIN_JWT_SECRET=
ADMIN_TOKEN_TTL_HOURS=12

# Print every SQL statement (development)
DB_LOG=false
